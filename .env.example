# Public site URL (used to build Stripe return links if Origin is missing)
NEXT_PUBLIC_SITE_URL="https://ritmokit.com"

# Stripe — RitmoKit SaaS subscriptions (you receive the money)
# Dashboard → Developers → API keys + Webhooks
# Webhook URL: https://YOUR_LANDING_HOST/api/stripe/webhook
# Event: checkout.session.completed
STRIPE_SECRET_KEY="sk_live_…"
STRIPE_WEBHOOK_SECRET="whsec_…"

# Demo form + ops notifications (defaults to info@ritmokit.com)
DEMO_INBOX="info@ritmokit.com"

# Optional: Resend for demo form + Stripe subscription alerts (else FormSubmit fallback for demo)
# RESEND_API_KEY=""
# EMAIL_FROM="RitmoKit <info@ritmokit.com>"
